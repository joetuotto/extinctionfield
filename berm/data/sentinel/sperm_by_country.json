  "_metadata": {
    "description": "Sperm concentration estimates by country/region, derived from Levine et al. meta-analyses and regional studies",
    "sources": [
      "Levine H et al. 2017. Hum Reprod Update 23(6):646-659. doi:10.1093/humupd/dmx022",
      "Levine H et al. 2023. Hum Reprod Update 29(2):157-176. doi:10.1093/humupd/dmac035",
      "Carlsen E et al. 1992. BMJ 305(6854):609-613 (original meta-analysis)",
      "Swan SH et al. 2000. Environ Health Perspect 108(10):961-966 (USA regional)",
      "Jorgensen N et al. 2012. Int J Androl 35(3):187-192 (Nordic comparison)",
      "Virtanen HE et al. 2017. Int J Androl 40:S12-S21 (Finland)"
    ],
    "notes": [
      "Values are mean sperm concentration in millions/mL at approximate midpoint of study period",
      "Levine 2023 overall trend: -51.6% decline 1973-2018, accelerating post-2000 (-2.64%/yr)",
      "Country-level estimates reconstructed from regional/national studies cited in meta-analyses",
      "These are AGGREGATED estimates with significant heterogeneity within countries",
      "Direct country-level time series from Levine meta are not publicly available in supplement",
      "Values below represent best available estimates from published regional studies"
    ],
    "units": "million_per_mL",
    "last_updated": "2026-08-18"
  },
