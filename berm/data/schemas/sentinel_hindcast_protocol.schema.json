{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berm/berm/data/schemas/sentinel_hindcast_protocol.schema.json",
  "title": "BERM sentinel-leading fertility hindcast protocol",
  "description": "A pre-registered sentinel -> human biology -> ASFR/TFR hindcast declaration. It is not a fitted result. Dynamic leakage and data-match rules are enforced by berm.validation.sentinel_hindcast_protocol.",
  "type": "object",
  "required": [
    "protocol_id",
    "version",
    "calibration_end_year",
    "lock_year",
    "forecast_origin_year",
    "target_window",
    "upstream_asset_ids",
    "demographic_baseline_asset_ids",
    "target_outcome_asset_id",
    "parameter_families",
    "lead_lag_rules",
    "geotemporal_matches",
    "calibration_geography_ids",
    "geographic_holdout_ids",
    "outputs"
  ],
  "properties": {
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "sentinel-hindcast-protocol-v1"
    },
    "calibration_end_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "lock_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "forecast_origin_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "target_window": {
      "type": "object",
      "required": [
        "start_year",
        "end_year"
      ],
      "properties": {
        "start_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        }
      },
      "additionalProperties": false
    },
    "upstream_asset_ids": {
      "$ref": "#/$defs/nonemptyIds"
    },
    "demographic_baseline_asset_ids": {
      "$ref": "#/$defs/nonemptyIds"
    },
    "target_outcome_asset_id": {
      "type": "string",
      "minLength": 1
    },
    "parameter_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/parameterFamily"
      }
    },
    "lead_lag_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lagRule"
      }
    },
    "geotemporal_matches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/geotemporalMatch"
      }
    },
    "calibration_geography_ids": {
      "$ref": "#/$defs/nonemptyIds"
    },
    "geographic_holdout_ids": {
      "$ref": "#/$defs/nonemptyIds"
    },
    "outputs": {
      "$ref": "#/$defs/nonemptyIds"
    }
  },
  "$defs": {
    "nonemptyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parameterFamily": {
      "type": "object",
      "required": [
        "family_id",
        "target_node",
        "parameter_ids",
        "scale_anchor_parameter_id",
        "calibration_asset_ids"
      ],
      "properties": {
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "target_node": {
          "type": "string",
          "minLength": 1
        },
        "parameter_ids": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "scale_anchor_parameter_id": {
          "type": "string",
          "minLength": 1
        },
        "calibration_asset_ids": {
          "$ref": "#/$defs/nonemptyIds"
        }
      },
      "additionalProperties": false
    },
    "lagRule": {
      "type": "object",
      "required": [
        "lag_id",
        "sentinel_endpoint",
        "human_endpoint",
        "minimum_lead_years",
        "maximum_lead_years",
        "biological_basis_asset_ids",
        "calibration_target",
        "locked_before_outcome_unblinding"
      ],
      "properties": {
        "lag_id": {
          "type": "string",
          "minLength": 1
        },
        "sentinel_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "human_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "minimum_lead_years": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximum_lead_years": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "biological_basis_asset_ids": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "calibration_target": {
          "const": "HUMAN_BIOLOGICAL_ENDPOINT"
        },
        "locked_before_outcome_unblinding": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "geotemporalMatch": {
      "type": "object",
      "required": [
        "match_id",
        "geography_id",
        "start_year",
        "end_year",
        "match_level",
        "fieldstate_asset_id",
        "sentinel_asset_id",
        "human_biomarker_asset_id",
        "confounder_asset_ids",
        "geography_crosswalk_id",
        "time_window_rule_id",
        "endpoint_definition_id"
      ],
      "properties": {
        "match_id": {
          "type": "string",
          "minLength": 1
        },
        "geography_id": {
          "type": "string",
          "minLength": 1
        },
        "start_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "end_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "match_level": {
          "enum": [
            "EXACT_SITE",
            "PREDEFINED_CATCHMENT",
            "SUBNATIONAL"
          ]
        },
        "fieldstate_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "sentinel_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "human_biomarker_asset_id": {
          "type": "string",
          "minLength": 1
        },
        "confounder_asset_ids": {
          "$ref": "#/$defs/nonemptyIds"
        },
        "geography_crosswalk_id": {
          "type": "string",
          "minLength": 1
        },
        "time_window_rule_id": {
          "type": "string",
          "minLength": 1
        },
        "endpoint_definition_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
