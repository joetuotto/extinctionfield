{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/berm/berm/data/schemas/anfr_fieldstate_feature_day.schema.json",
  "title": "BERM ANFR ambient-only FieldState feature candidate",
  "description": "One manifest-locked fixed-probe × published-calendar-day ANFR ambient-RF magnitude feature. This is deliberately not a FieldState observation, a personal/organism dose, or a biological join.",
  "type": "object",
  "required": [
    "bridge_id",
    "source_id",
    "source_manifest_id",
    "source_manifest_sha256",
    "source_summary_sha256",
    "source_artifact_sha256",
    "bridge_schema_version",
    "transform_pipeline_version",
    "aggregation_id",
    "country",
    "geography_id",
    "geography_level",
    "probe_key",
    "latitude",
    "longitude",
    "published_day",
    "time_window_start",
    "time_window_end",
    "first_observation_datetime",
    "last_observation_datetime",
    "datetime_timezone_status",
    "source_row_count",
    "ambient_v_per_m_mean",
    "ambient_v_per_m_rms",
    "ambient_v_per_m_stddev",
    "ambient_v_per_m_min",
    "ambient_v_per_m_max",
    "measurement_geometry_status",
    "personal_dose_status",
    "biological_join_status",
    "fieldstate_status",
    "measurement_ready",
    "fieldstate_components_present",
    "fieldstate_components_missing",
    "fieldstate_core_eligibility",
    "biological_join_eligibility"
  ],
  "properties": {
    "bridge_id": {"type": "string", "minLength": 1},
    "source_id": {"const": "ANFR_AUTONOMOUS_RF_PROBES"},
    "source_manifest_id": {"type": "string", "minLength": 1},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bridge_schema_version": {"const": "berm.anfr_fieldstate_feature_day@v1.0.0"},
    "transform_pipeline_version": {"const": "anfr_fieldstate_bridge@v1.0.0"},
    "aggregation_id": {"const": "ANFR_PUBLISHED_CALENDAR_DAY_V1"},
    "country": {"const": "FRA"},
    "geography_id": {"type": "string", "minLength": 1},
    "geography_level": {"const": "SITE"},
    "probe_key": {"type": "string", "minLength": 1},
    "latitude": {"type": "number", "minimum": -90, "maximum": 90},
    "longitude": {"type": "number", "minimum": -180, "maximum": 180},
    "published_day": {"type": "string", "format": "date"},
    "time_window_start": {"type": "string", "format": "date-time"},
    "time_window_end": {"type": "string", "format": "date-time"},
    "first_observation_datetime": {"type": "string", "format": "date-time"},
    "last_observation_datetime": {"type": "string", "format": "date-time"},
    "datetime_timezone_status": {"const": "LOCAL_TIME_REPORTED_TIMEZONE_NOT_DECLARED"},
    "source_row_count": {"type": "integer", "minimum": 1},
    "ambient_v_per_m_mean": {"type": "number", "minimum": 0},
    "ambient_v_per_m_rms": {"type": "number", "minimum": 0},
    "ambient_v_per_m_stddev": {"type": "number", "minimum": 0},
    "ambient_v_per_m_min": {"type": "number", "minimum": 0},
    "ambient_v_per_m_max": {"type": "number", "minimum": 0},
    "measurement_geometry_status": {"const": "FIXED_AUTONOMOUS_PROBE_AMBIENT_FIELD_AS_PUBLISHED"},
    "personal_dose_status": {"const": "NOT_A_PERSONAL_OR_ORGANISM_DOSE"},
    "biological_join_status": {"const": "NOT_JOINED_TO_BIOLOGY"},
    "fieldstate_status": {"const": "PARTIAL_FIELD_STATE"},
    "measurement_ready": {"const": false},
    "fieldstate_components_present": {"type": "string", "minLength": 1},
    "fieldstate_components_missing": {"type": "string", "minLength": 1},
    "fieldstate_core_eligibility": {"const": "NOT_ELIGIBLE_AMBIENT_ONLY_NO_MATCHED_BIOLOGICAL_PANEL"},
    "biological_join_eligibility": {"const": "NOT_ELIGIBLE_AMBIENT_ONLY_NO_MATCHED_BIOLOGICAL_PANEL"}
  },
  "additionalProperties": false
}
