# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
venv/
*.parquet
berm/berm/data/cache/

# Node
node_modules/
.next/
out/
.vercel/

# Data (large files — re-downloadable)
data/raw/
berm/data/raw/*
# ...but provenance must be version-controlled, even when the bytes are not.
# Manifests carry the sha256 of every raw artefact; without them in git there is
# no record of which data vintage produced a result.
!berm/data/raw/README.md
!berm/data/raw/manifests/

# Processed data (regenerated by parse_all.py)
data/processed/
berm/data/processed/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.production
